    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git filter-branch*)",

      "Bash(npm publish*)",
      "Bash(npm login*)",
      "Bash(npm adduser*)",
      "Bash(npm token*)",
      "Bash(npm unpublish*)",
      "Bash(npm deprecate*)",
      "Bash(npm owner*)",

      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",

      "Read(//home/claude/.ssh/**)",
      "Read(//home/claude/.aws/**)",
      "Read(//home/claude/.config/anthropic/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(//home/claude/.ssh/**)",
      "Edit(//home/claude/.aws/**)",
      "Edit(//etc/**)"
    ]
  }
}
