{
  "name": "mockingham",
  "version": "0.5.0",
  "description": "OpenAPI driven HTTP mock server",
  "homepage": "https://github.com/doesdev/mockingham#readme",
  "bugs": {
    "url": "https://github.com/doesdev/mockingham/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doesdev/mockingham.git"
  },
  "license": "MIT",
  "author": "Andrew Carpenter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "bin": {
    "mockingham": "./dist/server/cli.js"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.ts",
    "check:install": "node scripts/check-install.ts",
    "determinism": "node scripts/determinism.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "@modelcontextprotocol/sdk": ">=1.30.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
