# No trailing slash: worktrees symlink node_modules rather than copying it, and a
# trailing slash matches directories only - so `git add -A` in a worktree would
# stage the symlink.
node_modules
dist/
.claude/worktrees/
# Machine-local permissions, and it accumulates absolute scratchpad paths from
# whichever session wrote it. `.claude/settings.json` IS tracked and shared.
.claude/settings.local.json
.superpowers/
*.tsbuildinfo
.mockingham/
.env
.DS_Store
# A machine-migration bundle lands in the working tree as a 30MB archive of
# session history and dotfiles. It is a local artifact of moving machines, not
# repo content, and `git add -A` will otherwise commit it.
mockingham-migration.zip
